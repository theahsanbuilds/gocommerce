{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "admin: dev (SSR)",
            "program": "${workspaceFolder}/admin/node_modules/vite/bin/vite.js",
            "args": [
                "dev",
                "--open"
            ],
            "cwd": "${workspaceFolder}/admin",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "admin: Chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/admin",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "admin: full stack",
            "configurations": [
                "admin: dev (SSR)",
                "admin: Chrome"
            ]
        }
    ]
}